# ── Bot key ────────────────────────────────────────────────────────────────
# The bot key you linked in the dreamDEX app (Wallet menu -> Link a bot).
PRIVATE_KEY=0x...

# ── Account the bot trades for ─────────────────────────────────────────────
# Set this to use a trading key: orders route through placeOrderFor and the
# key can place and cancel orders but never withdraw funds.
OWNER_ADDRESS=0x...

# ── Market and sizing ──────────────────────────────────────────────────────
NETWORK=hideki
PERP_SYMBOL=ETH-PERP
PERP_SIDE=long
PERP_LEVERAGE=2
# Position VALUE, not margin: at 2x a notional of 60 needs about 30 USDso.
PERP_NOTIONAL_USDSO=60

# ── Risk bracket ───────────────────────────────────────────────────────────
PERP_TAKE_PROFIT_PCT=1.5
PERP_STOP_LOSS_PCT=1

# ── Loop ───────────────────────────────────────────────────────────────────
PERP_TICK_MS=10000
PERP_MAX_CYCLES=3
PERP_COOLDOWN_MS=15000
PERP_MAX_WAIT_PER_CYCLE_MS=900000

# ── Safety ─────────────────────────────────────────────────────────────────
# Keep this true until you have watched one full cycle. The bot reads this
# value from the environment, so a stale .env overrides every default in code.
DRY_RUN=true
